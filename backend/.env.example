# ====================================================================
# Nexus AI — Backend Environment Configuration Template
# Copy this file to .env and replace placeholder values with your credentials.
# Never commit real .env files with secrets to public version control.
# ====================================================================

PROJECT_NAME="Nexus AI"
API_V1_STR="/api/v1"
ENVIRONMENT="development"

# Cryptographic JWT Secret: Generate a secure 32+ character key for production
# Example to generate: openssl rand -hex 32
SECRET_KEY="your-random-32-character-secret-key-here"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration
# Local development default: SQLite
DATABASE_URL="sqlite:///./nexus_ai.db"
# Production PostgreSQL with pgvector:
# DATABASE_URL="postgresql+asyncpg://<db_user>:<db_password>@<db_host>:5432/nexus_ai"

# AI Provider Configuration (Gemini / OpenAI)
AI_DEFAULT_PROVIDER="gemini"
GEMINI_API_KEY="your_gemini_api_key_here"
OPENAI_API_KEY="your_openai_api_key_here"

# Monetization & Billing (Sandbox mode active by default)
BILLING_SANDBOX_MODE=true
RAZORPAY_KEY_ID="your_razorpay_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
CASHFREE_APP_ID="your_cashfree_app_id"
CASHFREE_SECRET_KEY="your_cashfree_secret_key"

# Optional: Local Demo User Seeding
SEED_DEMO_DATA=false
DEMO_USER_EMAIL="demo@nexusai.dev"
DEMO_USER_PASSWORD="your-strong-demo-password"

# CORS Configuration (Restricted to local Next.js frontend by default)
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]
